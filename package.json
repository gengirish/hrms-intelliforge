{
  "name": "hrms-intelliforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "stripe:check": "node scripts/stripe-setup-check.mjs",
    "learning:catalog": "node scripts/learning-catalog.mjs",
    "db:migrate": "node scripts/run-with-local-env.mjs npx prisma migrate deploy",
    "db:migrate:dev": "node scripts/run-with-local-env.mjs npx prisma migrate dev",
    "db:generate": "node scripts/run-with-local-env.mjs npx prisma generate",
    "db:studio": "node scripts/run-with-local-env.mjs npx prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/nextjs": "^10.62.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.3.2",
    "agentmail": "^0.4.13",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "next": "14.2.35",
    "openai": "^6.33.0",
    "posthog-js": "^1.396.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.72.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.3.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
