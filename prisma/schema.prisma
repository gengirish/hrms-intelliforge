generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InternStatus {
  PENDING
  OFFERED
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum AttendanceMode {
  WFH
  Office
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
}

enum NotificationType {
  WELCOME
  OFFER_LETTER
  OFFER_ACCEPTED
  TASK_REMINDER
  ATTENDANCE_NUDGE
  COMPLETION_CERT
  CUSTOM
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  MAGIC_LINK
}

model Intern {
  id               String       @id @default(cuid())
  passwordHash     String?
  emailVerified    Boolean      @default(false)
  name             String
  email            String       @unique
  phone            String
  college          String
  branch           String
  year             String
  role             String
  startDate        DateTime
  durationWeeks    Int
  stipendPaise     Int          @default(0)
  mentorId         String?
  mentor           Admin?       @relation("InternMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  aadharUrl        String?
  panUrl           String?
  photoUrl         String?
  agentmailInboxId String?
  agentmailAddress String?
  whatsappOptIn    Boolean      @default(false)
  status           InternStatus @default(PENDING)
  acceptedAt       DateTime?
  createdAt        DateTime     @default(now())

  attendance       Attendance[]
  tasks            Task[]
  notifications    NotificationLog[]
  notificationPref NotificationPreference?

  @@index([status])
  @@map("interns")
}

model Attendance {
  id       String    @id @default(cuid())
  internId String
  date     DateTime
  punchIn  DateTime?
  punchOut DateTime?
  mode     AttendanceMode

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, date])
  @@map("attendance")
}

model Task {
  id          String   @id @default(cuid())
  internId    String
  title       String
  description String
  status      TaskStatus
  hours       Float
  week        String
  createdAt   DateTime @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId, week])
  @@map("tasks")
}

model Admin {
  id            String   @id @default(cuid())
  passwordHash  String
  emailVerified Boolean  @default(false)
  email         String   @unique
  role          String   @default("ADMIN")
  mentees       Intern[] @relation("InternMentor")

  @@map("admins")
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String
  token      String
  type       TokenType
  expires    DateTime
  createdAt  DateTime  @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model NotificationLog {
  id          String              @id @default(cuid())
  internId    String
  channel     NotificationChannel
  type        NotificationType
  subject     String?
  body        String
  status      NotificationStatus  @default(PENDING)
  externalId  String?
  errorDetail String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId, createdAt])
  @@index([channel, status])
  @@index([externalId])
  @@map("notification_logs")
}

model NotificationPreference {
  id       String  @id @default(cuid())
  internId String  @unique
  email    Boolean @default(true)
  whatsapp Boolean @default(true)

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
