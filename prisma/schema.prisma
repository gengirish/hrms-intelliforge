generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InternStatus {
  PENDING
  OFFERED
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum AttendanceMode {
  WFH
  Office
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
}

enum NotificationType {
  WELCOME
  OFFER_LETTER
  OFFER_ACCEPTED
  TASK_REMINDER
  ATTENDANCE_NUDGE
  DAILY_PLAN_NUDGE
  COMPLETION_CERT
  COURSE_ENROLLED
  WEEKLY_PROGRESS_SUBMITTED
  WEEKLY_PROGRESS_FEEDBACK
  CUSTOM
}

enum DailyPlanStatus {
  DRAFT
  SUBMITTED
}

enum WeeklyProgressStatus {
  DRAFT
  SUBMITTED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  MAGIC_LINK
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  domain            String?
  logoUrl           String?
  whatsappPhoneId   String?
  whatsappToken     String?
  agentmailInboxId  String?
  agentmailEmail    String?
  plan              String   @default("free")
  stripeCustomerId  String?
  stripeSubId       String?
  maxInterns        Int      @default(5)
  createdAt         DateTime @default(now())

  admins       Admin[]
  interns      Intern[]
  jobPostings  JobPosting[]
  adminInvites AdminInvite[]

  @@map("organizations")
}

/// Pending workspace admin/mentor onboarding via email link (no shared password).
model AdminInvite {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  name      String?
  role      String
  /// When set, accepting the invite runs intern→admin promotion instead of a blank new account.
  internId  String?
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, email])
  @@map("admin_invites")
}

model Intern {
  id               String       @id @default(cuid())
  orgId            String
  /// Clerk user id (`user_*`) when linked for Clerk sign-in.
  clerkUserId      String?      @unique
  passwordHash     String?
  emailVerified    Boolean      @default(false)
  name             String
  email            String       @unique
  phone            String
  college          String
  branch           String
  year             String
  role             String
  startDate        DateTime
  durationWeeks    Int
  stipendPaise     Int          @default(0)
  mentorId         String?
  mentor           Admin?       @relation("InternMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  aadharUrl        String?
  panUrl           String?
  photoUrl         String?
  agentmailInboxId String?
  agentmailAddress String?
  whatsappOptIn    Boolean      @default(false)
  status           InternStatus @default(PENDING)
  deactivated      Boolean      @default(false)
  deactivatedAt    DateTime?
  acceptedAt       DateTime?
  createdAt        DateTime     @default(now())

  org                Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendance         Attendance[]
  tasks              Task[]
  notifications      NotificationLog[]
  notificationPref   NotificationPreference?
  botInteractions    BotInteractionLog[]
  performanceScores       PerformanceScore[]
  performanceReviews      PerformanceReview[]
  documentVerifications   DocumentVerification[]
  learningEnrollments     LearningEnrollment[]
  weeklyProgressReports   WeeklyProgressReport[]
  dailyTaskPlans          DailyTaskPlan[]

  @@index([orgId])
  @@index([status])
  @@map("interns")
}

model Attendance {
  id          String    @id @default(cuid())
  internId    String
  date        DateTime
  punchIn     DateTime?
  punchOut    DateTime?
  mode        AttendanceMode
  dailyStatus String?

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, date])
  @@map("attendance")
}

model Task {
  id          String   @id @default(cuid())
  internId    String
  title       String
  description String
  status      TaskStatus
  hours       Float
  week        String
  createdAt   DateTime @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId, week])
  @@map("tasks")
}

model Admin {
  id            String   @id @default(cuid())
  orgId         String
  /// Null when the admin only signs in via Clerk (no password).
  passwordHash  String?
  /// Clerk user id (`user_*`) when linked for SSO / Clerk sign-in.
  clerkUserId   String?  @unique
  emailVerified Boolean  @default(false)
  email         String   @unique
  name          String?
  role          String   @default("ADMIN")
  mentees       Intern[] @relation("InternMentor")
  enrolledLearners LearningEnrollment[] @relation("AdminEnrolledLearners")
  weeklyProgressFeedback WeeklyProgressReport[] @relation("WeeklyProgressFeedbackAuthor")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("admins")
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String
  token      String
  type       TokenType
  expires    DateTime
  createdAt  DateTime  @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model NotificationLog {
  id          String              @id @default(cuid())
  internId    String
  channel     NotificationChannel
  type        NotificationType
  subject     String?
  body        String
  status      NotificationStatus  @default(PENDING)
  externalId  String?
  errorDetail String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId, createdAt])
  @@index([channel, status])
  @@index([externalId])
  @@map("notification_logs")
}

model NotificationPreference {
  id       String  @id @default(cuid())
  internId String  @unique
  email    Boolean @default(true)
  whatsapp Boolean @default(true)

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PerformanceScore {
  id               String   @id @default(cuid())
  internId         String
  weekLabel        String
  attendanceScore  Float
  taskScore        Float
  consistencyScore Float
  overallScore     Float
  riskLevel        String   @default("LOW")
  createdAt        DateTime @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, weekLabel])
  @@map("performance_scores")
}

model PerformanceReview {
  id             String   @id @default(cuid())
  internId       String
  periodStart    DateTime
  periodEnd      DateTime
  summary        String
  recommendation String
  generatedAt    DateTime @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("performance_reviews")
}

model BotInteractionLog {
  id        String   @id @default(cuid())
  internId  String
  channel   String   @default("WHATSAPP")
  input     String
  intent    String
  response  String
  success   Boolean
  latencyMs Int?
  createdAt DateTime @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId, createdAt])
  @@map("bot_interaction_logs")
}

model DocumentVerification {
  id              String    @id @default(cuid())
  internId        String
  documentType    String
  documentUrl     String?
  extractedName   String?
  extractedNumber String?
  nameMatch       Boolean?
  formatValid     Boolean?
  status          String    @default("PENDING")
  reviewNote      String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@map("document_verifications")
}

model JobPosting {
  id                String   @id @default(cuid())
  orgId             String
  slug              String   @unique
  title             String
  description       String
  skills            String[]
  location          String?
  employmentType    String   @default("FULL_TIME")
  duration          String?
  responsibilities  String[]
  requirements      Json?
  bonusSkills       String[]
  perks             Json?
  interviewSteps    Json?
  applicationEmail  String?
  salaryInfo        String?
  interviewBotJobId String?
  interviewLink     String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  candidates Candidate[]

  @@index([orgId])
  @@map("job_postings")
}

model Candidate {
  id                String   @id @default(cuid())
  jobPostingId      String
  name              String
  email             String
  phone             String?
  resumeUrl         String?
  githubUrl         String?
  portfolioUrl      String?
  coverNote         String?
  interviewScore    Float?
  interviewStatus   String   @default("PENDING")
  reportUrl         String?
  convertedToIntern Boolean  @default(false)
  createdAt         DateTime @default(now())

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([jobPostingId])
  @@map("candidates")
}

// Tracks IntelliForge Learning (learning.intelliforge.tech) course
// enrollments that HRMS provisioned via the Learning v1 API. The record on
// the Learning side is the source of truth for progress; this row gives
// HRMS local idempotency + UI history without re-fetching across the wire.
model LearningEnrollment {
  id                   String   @id @default(cuid())
  internId             String
  intern               Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  courseId             String
  courseTitle          String
  courseSlug           String?
  learningEnrollmentId String?
  status               String   @default("active")
  progressTotal        Int?
  progressCompleted    Int?
  progressPercent      Int?
  completedAt          DateTime?
  enrolledByAdminId    String?
  enrolledByAdmin      Admin?   @relation("AdminEnrolledLearners", fields: [enrolledByAdminId], references: [id], onDelete: SetNull)
  enrolledAt           DateTime @default(now())
  lastSyncedAt         DateTime @default(now())

  @@unique([internId, courseId])
  @@index([internId])
  @@map("learning_enrollments")
}

model DailyTaskPlan {
  id          String           @id @default(cuid())
  internId    String
  date        DateTime
  status      DailyPlanStatus  @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  intern Intern          @relation(fields: [internId], references: [id], onDelete: Cascade)
  items  DailyTaskItem[]

  @@unique([internId, date])
  @@index([internId])
  @@map("daily_task_plans")
}

model DailyTaskItem {
  id          String     @id @default(cuid())
  planId      String
  title       String
  description String     @default("")
  status      TaskStatus @default(TODO)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())

  plan DailyTaskPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("daily_task_items")
}

model WeeklyProgressReport {
  id                String                @id @default(cuid())
  internId          String
  weekKey           String
  accomplishments   String                @default("")
  learningOutcomes  String                @default("")
  challenges        String                @default("")
  status            WeeklyProgressStatus  @default(DRAFT)
  submittedAt       DateTime?
  mentorFeedback    String?
  feedbackAt        DateTime?
  feedbackById      String?
  feedbackBy        Admin?                @relation("WeeklyProgressFeedbackAuthor", fields: [feedbackById], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, weekKey])
  @@index([internId])
  @@map("weekly_progress_reports")
}
