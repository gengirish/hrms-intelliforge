generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InternStatus {
  PENDING
  OFFERED
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum AttendanceMode {
  WFH
  Office
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
}

enum NotificationType {
  WELCOME
  OFFER_LETTER
  OFFER_ACCEPTED
  TASK_REMINDER
  ATTENDANCE_NUDGE
  COMPLETION_CERT
  CUSTOM
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  MAGIC_LINK
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  domain            String?
  logoUrl           String?
  whatsappPhoneId   String?
  whatsappToken     String?
  agentmailInboxId  String?
  agentmailEmail    String?
  plan              String   @default("free")
  stripeCustomerId  String?
  stripeSubId       String?
  maxInterns        Int      @default(5)
  createdAt         DateTime @default(now())

  admins      Admin[]
  interns     Intern[]
  jobPostings JobPosting[]

  @@map("organizations")
}

model Intern {
  id               String       @id @default(cuid())
  orgId            String?
  passwordHash     String?
  emailVerified    Boolean      @default(false)
  name             String
  email            String       @unique
  phone            String
  college          String
  branch           String
  year             String
  role             String
  startDate        DateTime
  durationWeeks    Int
  stipendPaise     Int          @default(0)
  mentorId         String?
  mentor           Admin?       @relation("InternMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  aadharUrl        String?
  panUrl           String?
  photoUrl         String?
  agentmailInboxId String?
  agentmailAddress String?
  whatsappOptIn    Boolean      @default(false)
  status           InternStatus @default(PENDING)
  acceptedAt       DateTime?
  createdAt        DateTime     @default(now())

  org                Organization?        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendance         Attendance[]
  tasks              Task[]
  notifications      NotificationLog[]
  notificationPref   NotificationPreference?
  botInteractions    BotInteractionLog[]
  performanceScores       PerformanceScore[]
  performanceReviews      PerformanceReview[]
  documentVerifications   DocumentVerification[]

  @@index([orgId])
  @@index([status])
  @@map("interns")
}

model Attendance {
  id       String    @id @default(cuid())
  internId String
  date     DateTime
  punchIn  DateTime?
  punchOut DateTime?
  mode     AttendanceMode

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, date])
  @@map("attendance")
}

model Task {
  id          String   @id @default(cuid())
  internId    String
  title       String
  description String
  status      TaskStatus
  hours       Float
  week        String
  createdAt   DateTime @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId, week])
  @@map("tasks")
}

model Admin {
  id            String   @id @default(cuid())
  orgId         String?
  passwordHash  String
  emailVerified Boolean  @default(false)
  email         String   @unique
  name          String?
  role          String   @default("ADMIN")
  mentees       Intern[] @relation("InternMentor")

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("admins")
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String
  token      String
  type       TokenType
  expires    DateTime
  createdAt  DateTime  @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model NotificationLog {
  id          String              @id @default(cuid())
  internId    String
  channel     NotificationChannel
  type        NotificationType
  subject     String?
  body        String
  status      NotificationStatus  @default(PENDING)
  externalId  String?
  errorDetail String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId, createdAt])
  @@index([channel, status])
  @@index([externalId])
  @@map("notification_logs")
}

model NotificationPreference {
  id       String  @id @default(cuid())
  internId String  @unique
  email    Boolean @default(true)
  whatsapp Boolean @default(true)

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PerformanceScore {
  id               String   @id @default(cuid())
  internId         String
  weekLabel        String
  attendanceScore  Float
  taskScore        Float
  consistencyScore Float
  overallScore     Float
  riskLevel        String   @default("LOW")
  createdAt        DateTime @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, weekLabel])
  @@map("performance_scores")
}

model PerformanceReview {
  id             String   @id @default(cuid())
  internId       String
  periodStart    DateTime
  periodEnd      DateTime
  summary        String
  recommendation String
  generatedAt    DateTime @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("performance_reviews")
}

model BotInteractionLog {
  id        String   @id @default(cuid())
  internId  String
  channel   String   @default("WHATSAPP")
  input     String
  intent    String
  response  String
  success   Boolean
  latencyMs Int?
  createdAt DateTime @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId, createdAt])
  @@map("bot_interaction_logs")
}

model DocumentVerification {
  id              String    @id @default(cuid())
  internId        String
  documentType    String
  documentUrl     String?
  extractedName   String?
  extractedNumber String?
  nameMatch       Boolean?
  formatValid     Boolean?
  status          String    @default("PENDING")
  reviewNote      String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@map("document_verifications")
}

model JobPosting {
  id                String   @id @default(cuid())
  orgId             String
  title             String
  description       String
  skills            String[]
  interviewBotJobId String?
  interviewLink     String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  candidates Candidate[]

  @@index([orgId])
  @@map("job_postings")
}

model Candidate {
  id                String   @id @default(cuid())
  jobPostingId      String
  name              String
  email             String
  phone             String?
  interviewScore    Float?
  interviewStatus   String   @default("PENDING")
  reportUrl         String?
  convertedToIntern Boolean  @default(false)
  createdAt         DateTime @default(now())

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([jobPostingId])
  @@map("candidates")
}
