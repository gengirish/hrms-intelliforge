# =============================================================================
# E2E / INTEGRATION test environment — TEMPLATE
# =============================================================================
# Copy this file to `.env.test` (gitignored) and fill in the real secrets.
# This template lives in the repo so contributors know what is needed.
# =============================================================================

# A DEDICATED Postgres database for E2E tests. NEVER point this at production.
# The prod-DB guard (`scripts/check-e2e-db.mjs`) will refuse to run if the URL
# matches a production hostname/database name.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

NODE_ENV=test
NEXT_PUBLIC_E2E=true

JWT_SECRET="any-non-empty-string-for-local-e2e"

# External services should be left empty for E2E so tests are deterministic.
# The lib/* modules log warnings and no-op when these are missing.
OPENAI_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_GROWTH_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""
AGENTMAIL_API_KEY=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
BLOB_READ_WRITE_TOKEN=""
CRON_SECRET="e2e-cron-secret"
INTERVIEW_BOT_WEBHOOK_SECRET="e2e-interview-bot-secret"

# Playwright baseURL — local server started by webServer config.
E2E_BASE_URL="http://localhost:3100"

# Optional: enables tests/e2e/weekly-progress.spec.ts “intern draft” flow against the same base URL.
# Use a dedicated test intern in a non-production database only.
# Provision locally: node --env-file=.env scripts/create-test-weekly-progress-users.mjs "Test1234!"
# Default script emails (override with E2E_* when running the script):
# E2E_INTERN_EMAIL="e2e-weekly-progress-intern@example.com"
# E2E_INTERN_PASSWORD="Test1234!"

# Optional: full mentor loop (intern submit → mentor feedback) in weekly-progress.spec.ts.
# The intern must be ACTIVE (or OFFERED if your API allows), and Intern.mentorId must point at this admin.
# The mentor admin must have role MENTOR (create-test-weekly-progress-users.mjs sets this).
# Use either mentor-specific or generic admin credentials:
# E2E_MENTOR_EMAIL="e2e-weekly-progress-mentor@example.com"
# E2E_MENTOR_PASSWORD="Test1234!"
# E2E_ADMIN_EMAIL="admin-e2e@example.com"
# E2E_ADMIN_PASSWORD="your-test-password"
