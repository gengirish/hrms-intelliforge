DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# AgentMail (https://docs.agentmail.to/) — see docs/AGENTMAIL.md for webhook + optional IMAP/SMTP
AGENTMAIL_API_KEY=am_your_api_key
AGENTMAIL_HR_INBOX_ID=hr@intelliforge.tech
CRON_SECRET=your-cron-secret
WEBHOOK_SECRET=your-webhook-secret

# WhatsApp Business API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_ACCESS_TOKEN=EAA...your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# OpenAI (WhatsApp bot + AI features)
OPENAI_API_KEY=sk-...

# Stripe Billing — see docs/STRIPE_SETUP.md for full setup (products, webhooks, Vercel)
#
# Test vs live: use sk_test_ / price_ from Test mode while developing; switch to
# sk_live_ / live price IDs only in Production on Vercel. Never mix test keys with
# live price IDs (or vice versa). Run `npm run stripe:check` to validate locally.
#
# Create prices: Stripe Dashboard → Products → Add product → Recurring → Monthly
#   Starter    $29/mo  → copy Price ID → STRIPE_STARTER_PRICE_ID
#   Growth     $79/mo  → copy Price ID → STRIPE_GROWTH_PRICE_ID
#   Enterprise (your list price) → STRIPE_ENTERPRISE_PRICE_ID
# Webhook signing secret: Developers → Webhooks → endpoint → Signing secret
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# JWT Secret for custom auth (min 32 chars) — used for intern/password sessions
JWT_SECRET=your-jwt-secret-min-32-characters-long

# Clerk (https://dashboard.clerk.com) — workspace admin SSO; interns can still use email/password
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Webhook signing secret from Clerk Dashboard → Webhooks (starts with whsec_)
CLERK_WEBHOOK_SECRET=whsec_...
# Optional Clerk routing (defaults work for /sign-in and /sign-up)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Pull dev keys: npm run clerk:login && npm run clerk:link && npm run clerk:env
# Optional session token claim (Dashboard → Sessions → Customize session token):
# { "metadata": "{{user.public_metadata}}" }

# Interview Bot Integration
INTERVIEW_BOT_API_URL=http://localhost:8000
INTERVIEW_BOT_API_KEY=your-interview-bot-api-key
INTERVIEW_BOT_WEBHOOK_SECRET=your-interview-bot-webhook-secret

# App URL (used in email templates and magic links)
NEXT_PUBLIC_APP_URL=https://hrms.intelliforge.tech

# IntelliForge Learning (https://learning.intelliforge.tech) — see docs/LEARNING_SETUP.md
# Mint a write-scoped API key at Learning → /admin/api-keys
LEARNING_API_KEY=ifk_...
# LEARNING_API_BASE_URL=https://learning.intelliforge.tech
# Auto-enroll when intern becomes ACTIVE (slugs preferred over opaque IDs)
LEARNING_AUTO_ENROLL_COURSE_SLUGS=intelliforge-intern-onboarding,software-engineering-with-gen-ai
# Bootcamp participants registration (must match published course title on Learning)
LEARNING_AUTO_REGISTER_SESSION=IntelliForge Intern Onboarding Stack Curriculum
# Optional explicit IDs instead of/in addition to slugs
# LEARNING_AUTO_ENROLL_COURSE_IDS=cmopvq5bu0000l504vc68xxeg,cmn9qn8xy001fqy0opqc87lln
# Live session ID — set when scheduled (requires Learning v1 sessions API deployed)
# LEARNING_AUTO_REGISTER_LIVE_SESSION_ID=
# Set to false to disable built-in intern onboarding slug defaults
# LEARNING_AUTO_ENROLL_DEFAULTS=false

# Optional product demo embed (Loom/YouTube share or embed URL) — homepage video section
NEXT_PUBLIC_DEMO_VIDEO_URL=
